{
  "schema": "spelldirector.template/0.1.0",
  "id": "wind-gale-shove",
  "name": "Gale Shove",
  "element": "wind",
  "archetype": "beam",
  "description": "The caster draws the air in with a quick swirl at the palm, then thrusts it out as a wide, rushing cone of wind: gust lines tear through it, dust and leaves are kicked up and blown back off the target, and the ground is swept into streaks.",
  "tags": ["cone", "gust", "push", "knockback", "quick", "area"],
  "source": {
    "kind": "director_text",
    "prompt": "A basic wind gust spell that pushes the target back (original, game-agnostic)."
  },
  "timing": { "duration_ms": 1500, "fps_hint": 30 },
  "space": {
    "origin": "caster_hand",
    "destination": "target",
    "travel": "beam",
    "scale": 1.0,
    "footprint": { "shape": "cone", "length": 3.4, "angle_deg": 40, "distribution": "center_weighted" }
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "The gust pours away from the camera: gust lines rush off the palm and spread out toward the target, where dust and leaves blow up and away.",
      "side": "The full cone from palm to target, narrow at the hand and widening, its lines streaking left to right; dust rolls along the ground and leaves lift off the target.",
      "top": "A wedge of streaks opening from the caster; the swept-dust mark fans out under it and the dust wave rolls out around the target.",
      "three_quarter": "The cone's width and length together, gust lines rushing through it, leaves and dust kicked up at the far end over a fan of swept streaks."
    }
  },
  "palette": {
    "core": "#F4F8F6",
