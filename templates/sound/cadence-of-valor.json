{
  "schema": "spelldirector.template/0.1.0",
  "id": "sound-cadence-of-valor",
  "name": "Cadence of Valor",
  "description": "A bard's marching song held as an aura: golden music notes circle the bard and drift upward, a beat ring rolls out across the ground on every downbeat and the staff circle under them turns in time.",
  "element": "sound",
  "line": "Bard",
  "archetype": "aura",
  "tags": [
    "aura",
    "looping",
    "sustained",
    "bard",
    "song",
    "music",
    "notes",
    "buff",
    "allies",
    "rhythm"
  ],
  "source": {
    "kind": "director_text",
    "prompt": "Bard music aura: notes orbiting the bard, rings on the beat, lasts as long as the song"
  },
  "timing": {
    "duration_ms": 5000,
    "fps_hint": 30,
    "loop_range": {
      "start_ms": 1200,
      "end_ms": 4200
    }
  },
  "space": {
    "origin": "caster",
    "destination": "caster",
    "travel": "none",
    "scale": 1.0,
    "footprint": {
      "shape": "circle",
      "radius": 2.4,
      "distribution": "even"
    }
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "Notes float round the bard at chest height and climb away; each downbeat a ring slides out along the ground.",
      "side": "Same notes passing in front of and behind the bard; the beat rings are thin bright lines on the ground.",
      "top": "Notes orbit the bard in a ring; the staff circle turns under them and the beat rings spread out like ripples.",
      "three_quarter": "Hero view. Orbiting notes, beat rings rolling out in time and the turning staff circle read as a song you can see."
    }
  },
  "palette": {
    "core": "#FFF7DC",
    "primary": "#FFC94A",
    "secondary": "#C27B1C",
    "accent": "#FFE6A0",
    "shadow": "#4C3818"
  },
  "beats": [
    {
      "id": "kindle",
      "phase": "anticipation",
      "start_ms": 0,
      "end_ms": 1200,
      "intensity": {
        "shape": "ease_out",
        "from": 0.0,
        "to": 1.0
      },
      "intent": "The bard strikes up: the staff circle draws itself, the first notes peel off the instrument and start to circle."
    },
    {
      "id": "sustain",
      "phase": "release",
      "start_ms": 1200,
      "end_ms": 4200,
      "intensity": {
        "shape": "hold",
        "from": 1.0
      },
      "intent": "The song holds: notes circle and rise, a ring rolls out on every beat (80 bpm) and the bard's glow pulses with it. Seamless loop."
    },
    {
      "id": "fade",
      "phase": "dissipation",
      "start_ms": 4200,
      "end_ms": 5000,
      "intensity": {
        "shape": "ease_in",
        "from": 1.0,
        "to": 0.0
      },
      "intent": "The song ends: the last notes drift away, the rings stop and the circle fades."
    }
