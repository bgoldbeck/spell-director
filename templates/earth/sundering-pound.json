{
  "schema": "spelldirector.template/0.1.0",
  "id": "earth-sundering-pound",
  "name": "Sundering Pound",
  "description": "A targetless ground pound that tears the earth open in a wide cone ahead of the caster: the slam splits the ground into deep fissures that race out nine metres across a 100 degree fan, rock bursts up row after row, and the chasms stay open, glowing faintly from deep inside and breathing dust, before they cool and close over.",
  "element": "earth",
  "archetype": "nova",
  "tags": [
    "ground",
    "slam",
    "cone",
    "frontal",
    "fissures",
    "chasm",
    "parallax",
    "lingering",
    "targetless",
    "melee",
    "area"
  ],
  "source": {
    "kind": "director_text",
    "prompt": "Ground pound should be usable with no target, be a larger area frontal cone, leave better ground marks with a parallax effect so it looks as if the ground has opened up, and be castable while moving."
  },
  "timing": {
    "duration_ms": 6400,
    "fps_hint": 30
  },
  "space": {
    "origin": "caster",
    "destination": "point",
    "travel": "instant",
    "scale": 1.0,
    "footprint": {
      "shape": "arc",
      "length": 5.0,
      "angle_deg": 100,
      "distribution": "edge_weighted"
    },
    "caster_gestures": [
      {
        "kind": "slam",
        "at_ms": 80,
        "duration_ms": 600,
        "hold_ms": 300,
        "return_ms": 500
      }
    ]
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "Over the shoulder the cone runs away from the camera: fissures race ahead and the rows of rock climb toward the far end of the 9 m fan. The open chasms keep reading as dark recessed slots with a warm glint at the bottom as the camera moves (parallax), not flat paint.",
      "side": "The staircase of rock grows left to right and the ground drops away into the cracks: lips of the fissures are lit, the walls fall into shadow, dust breathes up out of them during the linger.",
      "top": "The ground story is the hero here: a 100 degree fan of deep branching fissures and a crater at the caster's feet, the shock arc sweeping out ahead of the rock rows, embers cooling in the cracks, dust seeping out, then the whole fan fading.",
      "three_quarter": "Hero view. A widening fan of torn ground: rows of rock burst up toward the far tip, the fissures stay open behind them with visible depth and a cooling amber glow, then close over."
    }
  },
  "palette": {
    "core": "#F2E2C4",
    "primary": "#8C6B4A",
    "secondary": "#C4AC88",
    "accent": "#E8892F",
    "shadow": "#1E1712"
  },
  "beats": [
    {
      "id": "gather",
      "phase": "anticipation",
      "start_ms": 0,
      "end_ms": 600,
      "intensity": {
        "shape": "ease_in",
        "from": 0.15,
        "to": 0.9
      },
      "intent": "The caster heaves the weapon up, still walking if they like: a low rumble builds, grit lifts off the ground around them and a dull amber glow swells in the hands."
    },
    {
      "id": "hang",
      "phase": "anticipation",
      "start_ms": 600,
      "end_ms": 680,
      "intensity": {
        "shape": "hold",
        "from": 1.0,
        "to": 1.0
      },
      "intent": "A split second of stillness at the top of the swing: the pebbles hang in the air and the rumble holds. This hold is what makes the slam land."
    },
    {
      "id": "slam",
      "phase": "release",
      "start_ms": 680,
      "end_ms": 760,
      "intensity": {
        "shape": "spike",
        "from": 1.0,
        "to": 0.8
      },
      "intent": "The fist slams down: a hard thud and boom, a warm pop of dust, chunks of ground knocked loose, a crater punched under the caster and a sharp camera jolt."
    },
    {
      "id": "rupture",
      "phase": "travel",
      "start_ms": 720,
      "end_ms": 1500,
      "intensity": {
        "shape": "ease_in",
        "from": 0.45,
        "to": 1.0
      },
      "intent": "The ground splits open: fissures tear outward across a 100 degree cone, nine metres long, just ahead of six rows of rock that burst up bigger and a little later each time (crack, crack, CRACK). The cracks are deep: you can see down into them."
    },
    {
      "id": "climax",
      "phase": "impact",
      "start_ms": 1400,
      "end_ms": 1850,
      "intensity": {
        "shape": "ease_out",
        "from": 1.0,
        "to": 0.6
      },
      "intent": "The far row is the biggest: towering spikes at the tip of the cone, a deep boom, heavy rocks hurled high and a tall dust plume. The strongest shake."
    },
    {
      "id": "linger",
      "phase": "dissipation",
      "start_ms": 1800,
      "end_ms": 4800,
      "intensity": {
        "shape": "ease_out",
        "from": 0.6,
        "to": 0.25
      },
      "intent": "The rocks crumble back down, but the ground stays torn open: deep fissures with a faint amber glow far down that slowly cools, little puffs of dust breathing up out of the cracks, grit trickling over the lips."
    },
    {
      "id": "close",
      "phase": "dissipation",
      "start_ms": 4800,
      "end_ms": 6400,
      "intensity": {
        "shape": "ease_out",
        "from": 0.25,
        "to": 0.0
      },
      "intent": "The fissures lose their glow and fade away, the ground closing over as if it had settled back."
    }
  ],
