  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "From behind the caster the ground heaves on every side: slabs tilt up in rings that run away from the camera and toward it, dust rolls and pebbles bounce.",
      "side": "Rings of broken slabs rise on both sides of the caster, the far rings a little later than the near ones, with pebbles hopping across the ground between them.",
      "top": "The ground story: fissures racing out in every direction from the caster, rings of churned dust spreading, slabs popping up ring by ring, then the cracked ground left behind.",
      "three_quarter": "Hero view. The whole area around the caster heaves: rings of slabs rising and settling, fissures, dust and bouncing pebbles, all under a long heavy shake."
    }
  },
