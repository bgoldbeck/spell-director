{
  "schema": "spelldirector.template/0.1.0",
  "id": "fire-dragon-breath",
  "name": "Dragon Breath",
  "description": "A creature draws a deep breath while fire builds in its mouth, then unleashes a roaring, widening cone of flame that sweeps across the target, splashes into billows and embers, and leaves a long burning swath that cools to scorch.",
  "element": "fire",
  "archetype": "beam",
  "tags": [
    "cone",
    "breath",
    "sweep",
    "sustained",
    "area",
    "burning-ground"
  ],
  "source": {
    "kind": "director_text",
    "prompt": "Create a fire category with a dragon-style fire breath (a creature's sustained cone of flame) as the attack to build a template around."
  },
  "timing": {
    "duration_ms": 2200,
    "fps_hint": 30
  },
  "space": {
    "origin": "caster_hand",
    "destination": "target",
    "travel": "beam",
    "scale": 1.0,
    "footprint": {
      "shape": "cone",
      "length": 3.6,
      "angle_deg": 35,
      "distribution": "center_weighted"
    }
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "The breath points away from the camera: the mouth flare fills the near side, the cone opens out toward the target, and the billows, embers and the burning swath rise and spread at the far end.",
      "side": "Full length of the cone from mouth to target: narrow and white-yellow at the mouth, widening and reddening as it goes, with tongues tearing off the top edge and embers drifting up off it.",
      "top": "A wedge of fire opening from the caster, its far end swinging across the target; the ground story carries it: a long glowing swath across the line of fire that cools into a black scorch, flame billows and embers drifting off the area. The closing inhale ring shows the wind-up.",
      "three_quarter": "Hero view. The cone reads as a 3D wedge receding to the target, the sweep is visible as the far end swings, billows rise tall, and the scorch swath reads as a long ellipse across the line of fire."
    }
  },
  "palette": {
    "core": "#FFF3C4",
    "primary": "#FF8A1F",
    "secondary": "#D3340F",
    "accent": "#FFC247",
    "shadow": "#2A2320"
  },
  "beats": [
    {
      "id": "inhale",
      "phase": "anticipation",
      "start_ms": 0,
      "end_ms": 500,
      "intensity": {
        "shape": "ease_in",
        "from": 0.1,
        "to": 0.85
      },
      "intent": "The creature draws a deep breath: air and dust pull in around it, smoke curls from its mouth and fire swells inside, glowing brighter and throbbing faster."
    },
    {
      "id": "ignite",
      "phase": "release",
      "start_ms": 500,
      "end_ms": 580,
      "intensity": {
        "shape": "spike",
        "from": 1.0,
        "to": 0.85
      },
      "intent": "The breath catches with a bright yellow flare and a spray of sparks at the mouth. A short pop, then straight into the stream."
    },
    {
      "id": "breath",
      "phase": "travel",
      "start_ms": 540,
      "end_ms": 1460,
      "intensity": {
        "shape": "flicker",
        "from": 0.8,
        "to": 1.0,
        "flicker_hz": 8
      },
      "intent": "A roaring cone of fire pours out, reaching the target in about 0.2 s, then holds and sweeps across it. White-yellow at the mouth, orange in the body, red and smoky at the edges, with tongues of flame tearing off it."
    },
    {
      "id": "burn",
      "phase": "impact",
      "start_ms": 760,
      "end_ms": 1500,
      "intensity": {
        "shape": "flicker",
        "from": 0.7,
        "to": 1.0,
        "flicker_hz": 7
      },
      "intent": "Where the flames hit they splash up in glowing billows and sparks, the ground catches along the sweep, heat rolls outward and embers start to rise."
    },
    {
      "id": "smolder",
      "phase": "dissipation",
      "start_ms": 1450,
      "end_ms": 2200,
      "intensity": {
        "shape": "ease_out",
        "from": 0.6,
        "to": 0.0
      },
      "intent": "The breath runs out and the stream thins from the mouth. The ground keeps burning for a moment, embers drift up, smoke rises, and a long black scorch is left behind."
    }
  ],
