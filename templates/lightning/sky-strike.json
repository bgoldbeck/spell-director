  "id": "lightning-sky-strike",
  "name": "Sky Strike",
  "description": "A bolt drops from the sky onto one target. The air gathers static, a faint leader feels for the ground, then a blinding return stroke hits and flickers twice before leaving a scorch mark.",
  "element": "lightning",
  "archetype": "strike",
  "tags": [
    "single-target",
    "heavy",
    "outdoor",
    "natural"
  ],
  "source": {
    "kind": "handwritten"
