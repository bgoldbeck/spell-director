  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "A tall vertical bolt from the top of frame down to the target, branches spreading left and right. Ring and scorch read as a thin bright line on the ground.",
      "side": "Same vertical bolt, with a different branch pattern seen edge-on. Use it to check the bolt has depth and isn't flat.",
      "top": "The bolt collapses to a bright point. The story is told by the ground: static crawling in a circle, the expanding ring, sparks spraying outward radially, and the scorch mark with glowing cracks that cool to black.",
      "three_quarter": "Hero view. Bolt reads tall with visible branches, and the ring and scorch read as ellipses so you see both the strike and its footprint."
    }
  },
  "palette": {
    "core": "#FFFFFF",
    "primary": "#9ADFFF",
    "secondary": "#3D5CFF",
    "accent": "#FFF3A6",
    "shadow": "#141A33"
  },
  "beats": [
