{
  "schema": "spelldirector.template/0.1.0",
  "id": "lightning-sky-strike",
  "name": "Sky Strike",
  "description": "A bolt drops from the sky onto one target. The air gathers static, a faint leader feels for the ground, then a blinding return stroke hits and flickers twice before leaving a scorch mark.",
  "element": "lightning",
  "archetype": "strike",
  "tags": ["single-target", "heavy", "outdoor", "natural"],
  "source": { "kind": "handwritten" },
  "timing": { "duration_ms": 1100, "fps_hint": 30 },
  "space": {
    "origin": "sky",
    "destination": "target",
    "travel": "instant",
    "scale": { "min": 3.5, "max": 4.5 },
    "footprint": { "shape": "circle", "radius": 0.8, "distribution": "center_weighted" }
  },
  "palette": {
    "core": "#FFFFFF",
    "primary": "#9ADFFF",
    "secondary": "#3D5CFF",
    "accent": "#FFF3A6",
    "shadow": "#141A33"
  },
  "beats": [
    { "id": "gather", "phase": "anticipation", "start_ms": 0, "end_ms": 380,
      "intensity": { "shape": "ease_in", "from": 0.05, "to": 0.5 },
      "intent": "The area darkens slightly and static crawls on the ground under the target. The player should sense the hit coming." },
    { "id": "strike", "phase": "release", "start_ms": 380, "end_ms": 450,
      "intensity": { "shape": "spike", "from": 1.0, "to": 0.7 },
      "intent": "A faint stepped leader, then the full-brightness bolt. Hold the brightest frame for 2 frames." },
    { "id": "restrike", "phase": "impact", "start_ms": 450, "end_ms": 640,
      "intensity": { "shape": "flicker", "from": 0.4, "to": 1.0, "flicker_hz": 14 },
      "intent": "Same path flashes twice more. Sparks burst out and the ground ring expands." },
    { "id": "fade", "phase": "dissipation", "start_ms": 600, "end_ms": 1100,
      "intensity": { "shape": "ease_out", "from": 0.5, "to": 0.0 },
      "intent": "Afterimage fades, small crackles linger on the scorch mark, light smoke rises." }
  ],
  "layers": [
    { "id": "ground-static", "type": "crackle", "beats": ["gather"], "anchor": "target", "color": "primary", "z": 2,
      "params": { "count": { "min": 3, "max": 6 }, "length_px": { "min": 10, "max": 22 }, "jaggedness": 0.8, "regen_ms": 50, "radius_px": 40 } },
    { "id": "sky-dim", "type": "flash", "beats": ["gather"], "anchor": "screen", "blend": "multiply", "color": "shadow", "z": 0,
      "params": { "scope": "screen", "peak": 0.25 } },
    { "id": "main-bolt", "type": "bolt", "beats": ["strike", "restrike"], "anchor": "sky", "color": "gradient_core_to_primary", "z": 10,
      "params": {
        "segments": { "min": 18, "max": 26 },
        "jaggedness": { "min": 0.55, "max": 0.75 },
        "width_px": { "min": 6, "max": 9 },
        "taper": 0.6,
        "branch_chance": { "min": 0.25, "max": 0.4 },
        "branch_depth": 2,
        "branch_length_ratio": 0.35,
        "regen_ms": 0,
        "leader_ms": 40,
        "restrikes": 2,
        "restrike_gap_ms": 60,
        "afterimage_ms": 220,
        "glow_px": 18
      },
      "keyframes": [ { "t_ms": 640, "param": "width_px", "value": 2, "ease": "ease_out" } ] },
    { "id": "bolt-glow", "type": "glow", "beats": ["strike", "restrike"], "attach_to": "main-bolt", "color": "secondary", "z": 8,
      "params": { "radius_px": 34, "softness": 0.8 } },
    { "id": "strike-flash", "type": "flash", "beats": ["strike"], "anchor": "screen", "color": "core", "z": 20,
      "params": { "scope": "screen", "peak": { "min": 0.55, "max": 0.7 } } },
    { "id": "impact-sparks", "type": "sparks", "beats": ["restrike"], "anchor": "target", "color": "accent", "z": 12,
      "params": { "count": { "min": 18, "max": 28 }, "speed": 420, "speed_spread": 0.5, "gravity": 900, "lifetime_ms": { "min": 250, "max": 450 }, "size_px": 3, "spread_deg": 160, "drag": 0.15 } },
    { "id": "impact-ring", "type": "ring", "beats": ["restrike"], "anchor": "target", "color": "primary", "z": 4,
      "params": { "start_radius_px": 10, "end_radius_px": 90, "thickness_px": 6, "softness": 0.6 } },
    { "id": "scorch", "type": "decal", "beats": ["restrike", "fade"], "anchor": "target", "blend": "alpha", "color": "shadow", "z": 1,
      "params": { "radius_px": 46, "shape": "cracks", "fade_ms": 400 } },
    { "id": "linger-crackle", "type": "crackle", "beats": ["fade"], "anchor": "target", "color": "primary", "z": 3,
      "params": { "count": { "min": 2, "max": 4 }, "length_px": 14, "jaggedness": 0.85, "regen_ms": 70, "radius_px": 30 } },
    { "id": "smoke", "type": "smoke", "beats": ["fade"], "anchor": "target", "blend": "alpha", "color": "shadow", "z": 5,
      "params": { "count": 6, "rise_speed": 40, "size_px": 26, "lifetime_ms": 500, "opacity": 0.35 } },
    { "id": "shake", "type": "camera_shake", "beats": ["strike", "restrike"],
      "params": { "amplitude_px": { "min": 6, "max": 9 }, "frequency_hz": 28, "decay": 0.8 } },
    { "id": "impact-light", "type": "light", "beats": ["strike", "restrike"], "anchor": "target", "color": "primary",
      "params": { "radius": 6, "energy": 3.0 } },
    { "id": "crack-sound", "type": "sound_cue", "beats": ["strike"], "params": { "cue": "crack" } },
    { "id": "boom-sound", "type": "sound_cue", "beats": ["restrike"], "params": { "cue": "boom" } }
  ],
  "variation": { "seeded": true, "notes": "Bolt path, branch count, spark spray and shake strength change per cast. Timing is fixed so it lines up with gameplay hit frames." },
  "director_notes": "Long gather vs. 70 ms strike gives weight. Restrike flicker is the signature of natural lightning. Main bolt stays solid (regen_ms 0) so it reads as one strike, while crackles regenerate fast to feel alive."
}
