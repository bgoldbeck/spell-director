      "start_ms": 0,
      "end_ms": 380,
      "intensity": {
        "shape": "ease_in",
        "from": 0.05,
        "to": 0.5
      },
      "intent": "The area darkens slightly and static crawls on the ground under the target. The player should sense the hit coming."
    },
    {
      "id": "strike",
      "phase": "release",
      "start_ms": 380,
      "end_ms": 450,
      "intensity": {
        "shape": "spike",
        "from": 1.0,
        "to": 0.7
      },
      "intent": "A faint stepped leader, then the full-brightness bolt. Hold the brightest frame for 2 frames."
    },
    {
      "id": "restrike",
      "phase": "impact",
      "start_ms": 450,
      "end_ms": 640,
      "intensity": {
        "shape": "flicker",
        "from": 0.4,
        "to": 1.0,
        "flicker_hz": 14
      },
      "intent": "Same path flashes twice more. Sparks burst out and the ground ring expands."
    },
    {
      "id": "fade",
      "phase": "dissipation",
