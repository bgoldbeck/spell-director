{
  "schema": "spelldirector.template/0.1.0",
  "id": "lightning-ball-lightning",
  "name": "Ball Lightning",
  "description": "A crackling ball of lightning gathers in the caster's hand, flies at the target trailing a streak of light, and bursts on contact.",
  "element": "lightning",
  "archetype": "projectile",
  "tags": [
    "projectile",
    "single-target",
    "caster"
  ],
  "source": {
    "kind": "handwritten"
  },
  "timing": {
    "duration_ms": 1300,
    "fps_hint": 30
  },
  "space": {
    "origin": "caster_hand",
    "destination": "target",
    "travel": "projectile",
    "scale": 1.0,
    "footprint": {
      "shape": "line",
      "length": 5,
      "distribution": "center_weighted"
    }
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "The ball shrinks into the distance as it flies away from the camera; the trail is short from here, so the burst on the target sells the hit.",
      "side": "Clearest read of the flight: the ball crosses left to right with a tapering streak behind it and a slight lob.",
      "top": "The flight path is a straight line from caster to target; the burst ring and the scorch mark show where it landed.",
      "three_quarter": "Hero view. The ball arcs toward the target with its streak, then the flash, sparks and ring burst outward and leave a scorch."
    }
  },
  "palette": {
    "core": "#FFFFFF",
    "primary": "#9FE3FF",
    "secondary": "#3D7BFF",
    "accent": "#FFF3A8",
    "shadow": "#1A1B2A"
  },
  "beats": [
    {
      "id": "gather",
      "phase": "anticipation",
      "start_ms": 0,
      "end_ms": 320,
      "intensity": { "shape": "ease_in", "from": 0.2, "to": 0.85 },
      "intent": "A ball of static gathers in the hand, crackling."
    },
    {
      "id": "launch",
      "phase": "release",
      "start_ms": 320,
      "end_ms": 370,
      "intensity": { "shape": "spike", "from": 1, "to": 0.9 },
      "intent": "The ball snaps forward out of the hand."
    },
    {
      "id": "flight",
      "phase": "travel",
      "start_ms": 360,
      "end_ms": 760,
      "intensity": { "shape": "flicker", "from": 0.75, "to": 1, "flicker_hz": 14 },
      "intent": "The ball flies at the target with a bright streak behind it."
    },
    {
      "id": "burst",
      "phase": "impact",
      "start_ms": 760,
      "end_ms": 900,
      "intensity": { "shape": "spike", "from": 1, "to": 0.4 },
      "intent": "It bursts on the target: flash, sparks and a ring of light."
    },
    {
      "id": "fade",
      "phase": "dissipation",
      "start_ms": 860,
      "end_ms": 1300,
      "intensity": { "shape": "ease_out", "from": 0.5, "to": 0 },
      "intent": "Static crawls over the scorched ground and fades."
    }
  ],
  "layers": [
    {
      "id": "ball",
      "type": "orb",
      "beats": ["gather", "launch", "flight"],
      "anchor": "caster_hand",
      "color": "gradient_core_to_primary",
      "z": 10,
      "params": {
        "radius_px": { "min": 9, "max": 11 },
        "pulse_hz": 8,
        "wobble": 0.2,
        "crackle_count": 4,
        "trail_ms": 160,
        "arc_height_px": { "min": 30, "max": 50 }
      }
    },
    {
      "id": "ball-glow",
      "type": "glow",
      "beats": ["gather", "launch", "flight"],
      "attach_to": "ball",
      "color": "primary",
      "z": 8,
      "params": { "radius_px": 26, "softness": 0.85, "pulse_hz": 8 }
    },
    {
      "id": "hand-static",
      "type": "crackle",
      "beats": ["gather"],
      "anchor": "caster_hand",
      "color": "primary",
      "z": 7,
      "params": { "count": 3, "length_px": 14, "jaggedness": 0.85, "regen_ms": 40, "radius_px": 50 }
    },
    {
      "id": "hit-flash",
      "type": "flash",
      "beats": ["burst"],
      "anchor": "target",
      "color": "core",
      "z": 16,
      "params": { "scope": "local", "radius_px": 70, "peak": 0.9 }
    },
    {
      "id": "hit-sparks",
      "type": "sparks",
      "beats": ["burst"],
      "anchor": "target",
      "color": "accent",
      "z": 14,
      "params": {
        "count": { "min": 28, "max": 36 },
        "speed": 380,
        "speed_spread": 0.6,
        "gravity": 800,
        "lifetime_ms": { "min": 300, "max": 480 },
        "size_px": 3,
        "spread_deg": 200,
        "drag": 0.15
      }
    },
    {
      "id": "hit-ring",
      "type": "ring",
      "beats": ["burst"],
      "anchor": "target",
      "color": "primary",
      "z": 4,
      "params": { "start_radius_px": 12, "end_radius_px": 85, "thickness_px": 8, "softness": 0.7 }
    },
    {
      "id": "scorch",
      "type": "decal",
      "beats": ["burst", "fade"],
      "anchor": "target",
      "color": "shadow",
      "z": 1,
      "params": { "radius_px": 38, "shape": "scorch", "fade_ms": 300 }
    },
    {
      "id": "linger-static",
      "type": "crackle",
      "beats": ["fade"],
      "anchor": "target",
      "color": "primary",
      "z": 3,
      "params": { "count": { "min": 2, "max": 3 }, "length_px": 12, "jaggedness": 0.85, "regen_ms": 60, "radius_px": 28 }
    },
    {
      "id": "shake",
      "type": "camera_shake",
      "beats": ["burst"],
      "params": { "amplitude_px": 4, "frequency_hz": 28, "decay": 0.8 }
    },
    {
      "id": "hit-light",
      "type": "light",
      "beats": ["burst"],
      "anchor": "target",
      "color": "primary",
      "params": { "radius": 5, "energy": 2.5 }
    },
    {
      "id": "charge-sound",
      "type": "sound_cue",
      "beats": ["gather"],
      "params": { "cue": "charge", "gain": 0.6 }
    },
    {
      "id": "launch-sound",
      "type": "sound_cue",
      "beats": ["launch"],
      "params": { "cue": "zap" }
    },
    {
      "id": "flight-sound",
      "type": "sound_cue",
      "beats": ["flight"],
      "params": { "cue": "buzz", "gain": 0.4 }
    },
    {
      "id": "burst-sound",
      "type": "sound_cue",
      "beats": ["burst"],
      "params": { "cue": "crack", "pitch": { "min": 1.0, "max": 1.15 } }
    }
  ],
  "variation": {
    "seeded": true,
    "notes": "Ball size and the height of the lob vary per cast; the crackle around the ball and the spark burst are reseeded every cast."
  },
  "director_notes": "Projectile archetype: the orb's travel beat moves it from the hand to the target, so the impact layers start exactly when the travel beat ends. The lob (arc_height_px) keeps the flight readable from the side view, and the trail gives the motion a direction in a still frame."
}
