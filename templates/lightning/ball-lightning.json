      }
    ]
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "The ball shrinks into the distance as it flies away from the camera; the trail is short from here, so the burst on the target sells the hit.",
      "side": "Clearest read of the flight: the ball crosses left to right with a tapering streak behind it and a slight lob.",
      "top": "The flight path is a straight line from caster to target; the burst ring and the scorch mark show where it landed.",
      "three_quarter": "Hero view. The ball arcs toward the target with its streak, then the flash, sparks and ring burst outward and leave a scorch."
    }
  },
  "palette": {
    "core": "#FFFFFF",
    "primary": "#9FE3FF",
    "secondary": "#3D7BFF",
    "accent": "#FFF3A8",
    "shadow": "#1A1B2A"
