  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "From behind the caster: three hammers spin beside them, then fan out left, centre and right and converge on the target. The fork spreads across the group like a cracked windscreen.",
      "side": "The hammers lob slightly and tumble end over end; the slam flash and the shockwave are flat on the ground with forks at chest height.",
      "top": "Hero for the splash: the hammers' paths make a closing fan; the shockwave ring and the forks radiating to every enemy show the area plainly, with a glowing crack under each.",
      "three_quarter": "Hero view. Spinning hammer silhouettes with streaks behind, a big ground ring and forks to each enemy at different depths."
    }
  },
