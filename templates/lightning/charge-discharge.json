{
  "schema": "spelldirector.template/0.1.0",
  "id": "lightning-charge-discharge",
  "name": "Charge and Discharge",
  "description": "The caster gathers a crackling orb of electricity, which swells and destabilizes, then releases it as a thick, wobbling beam in a straight line.",
  "element": "lightning",
  "archetype": "beam",
  "tags": [
    "line",
    "charged",
    "boss",
    "heavy"
  ],
