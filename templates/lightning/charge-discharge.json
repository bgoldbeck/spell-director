      "length": {
        "min": 8,
        "max": 10
      },
      "distribution": "even"
    }
  },
  "views": {
    "hero": "side",
    "reads": {
      "front": "Beam points at the camera: the orb grows into a bright disk, then the beam reads as a flaring circle with arcs radiating outward. Shows the charge-up best.",
      "side": "Hero view. Full length of the beam from hand to end point, wobble and peeling arcs visible, spark fountain at the far end.",
      "top": "The beam is a straight line on the ground plane; its length and the end ring show the area it covers. Inflow arcs read as spokes pulling into the orb.",
      "three_quarter": "Beam recedes diagonally into the scene, with both its length and its width visible."
    }
  },
  "palette": {
    "core": "#FFFFFF",
    "primary": "#8CF0FF",
    "secondary": "#1E8CFF",
    "accent": "#FFFFFF",
    "shadow": "#0B1530"
  },
  "beats": [
    {
      "id": "charge",
      "phase": "anticipation",
      "start_ms": 0,
      "end_ms": 650,
      "intensity": {
        "shape": "ease_in",
        "from": 0.1,
        "to": 0.9
      },
      "intent": "Orb grows in the hand. Small arcs get pulled into it from around the caster. It should feel like pressure building."
    },
    {
      "id": "overload",
      "phase": "anticipation",
      "start_ms": 650,
      "end_ms": 780,
      "intensity": {
        "shape": "flicker",
        "from": 0.8,
        "to": 1.0,
        "flicker_hz": 22
      },
      "intent": "A short unstable moment: the orb shudders and crackles wildly just before release."
    },
    {
      "id": "fire",
      "phase": "release",
      "start_ms": 780,
      "end_ms": 840,
      "intensity": {
        "shape": "spike",
        "from": 1.0,
        "to": 0.85
      },
      "intent": "The beam snaps out to full length in two frames, with a white flash at the hand."
    },
    {
      "id": "sustain",
      "phase": "travel",
      "start_ms": 840,
      "end_ms": 1200,
      "intensity": {
        "shape": "flicker",
        "from": 0.75,
        "to": 0.95,
        "flicker_hz": 16
      },
      "intent": "The beam holds and writhes, with sparks peeling off along its length."
    },
    {
      "id": "end-hit",
      "phase": "impact",
      "start_ms": 800,
      "end_ms": 1200,
      "intensity": {
        "shape": "hold",
        "from": 0.8
      },
      "intent": "A spark fountain and ring of light where the beam ends."
    },
    {
      "id": "collapse",
      "phase": "dissipation",
      "start_ms": 1200,
      "end_ms": 1600,
      "intensity": {
        "shape": "ease_out",
        "from": 0.7,
        "to": 0.0
      },
      "intent": "The beam thins from the hand outward and breaks into a few fading arcs. Thin smoke trails from the hand."
    }
