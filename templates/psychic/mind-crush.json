      "length": 4.0,
      "distribution": "center_weighted"
    },
    "caster_gestures": [
      {
        "kind": "point",
        "at_ms": 300,
        "duration_ms": 300,
        "hold_ms": 250
      }
    ]
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "From behind the caster: ripples of warped space pulse out of the hand toward the camera, a wavering pink link reaches the target, and the target hangs in a glowing bubble ringed by ripples that tighten and then burst.",
      "side": "The cleanest read of lift and crush: debris and motes float up round the target inside the bubble, ripples ring it at chest height, the bubble shrinks fast onto the target and bursts with a flash and thrown sparks.",
      "top": "A glyph circle turns under the target while the bubble reads as a disc and the ripples as concentric rings that close in; the crush is a ring bursting out across the ground and glowing cracks left behind. A smaller glyph under the caster shows where the force comes from.",
      "three_quarter": "Hero view. The bubble reads as a sphere around the target with the ripples facing the camera, debris floats up through it, the glyph reads as an ellipse, and the collapse and burst are clear."
    }
  },
  "palette": {
    "core": "#FFF0FB",
    "primary": "#FF5FD2",
    "secondary": "#8A4BFF",
    "accent": "#8FF3FF",
    "shadow": "#1E1529"
