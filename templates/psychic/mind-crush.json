    "single-target",
    "control"
  ],
  "source": {
    "kind": "director_text",
    "prompt": "A psychic telekinetic attack: warping distortion, lifting the target and crushing it. Original, inspired by the psychic-move archetype common in creature-battle games."
  },
  "timing": {
    "duration_ms": 2500,
    "fps_hint": 30
  },
  "space": {
    "origin": "caster_hand",
    "destination": "target",
    "travel": "instant",
