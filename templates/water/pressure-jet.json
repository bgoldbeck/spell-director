  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "Jet points at the camera: the gathering water ball and the splash fountain carry it. The fountain rises above the target and droplets fall back down on all sides.",
      "side": "Full length of the jet from hand to target. The leading end visibly travels for the first 180 ms, the stream ripples while it holds, then it thins from the hand outward.",
      "top": "The jet is a straight blue line; the splash ripples and the lumpy puddle at the target show where it landed. Droplets land in a ring around the target. The ground darkens as it gets wet, a puddle spreads under the target and splashed droplets dot the area around it; the wet patch stays after the spell.",
      "three_quarter": "Hero view. The jet recedes toward the target, the fountain reads tall, and the ripple and puddle read as ellipses on the ground."
    }
  },
  "palette": {
    "core": "#F2FBFF",
    "primary": "#4FB8FF",
    "secondary": "#1A5FD6",
    "accent": "#BFF0FF"
  },
