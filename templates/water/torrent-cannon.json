  "views": {
    "hero": "side",
    "reads": {
      "front": "The torrent points away from the camera: the swelling sphere at the hands fills the bottom of the frame, then the column punches away and a tall crown of spray erupts over the target.",
      "side": "Hero view. A thick churning column, as wide as the caster's head, with surges pounding down it; the caster's ripple ring and recoil shake on release, and the towering splash at the target.",
      "top": "A wide blue band from hand to target with foam racing along it. The inward ring at the caster during the gather, the big ripples and the wide puddle at the target carry the timing.",
      "three_quarter": "The column recedes diagonally to the target; the gather sphere, the splash crown and the spreading puddle all read in full."
    }
  },
