  "views": {
    "hero": "top",
    "reads": {
      "front": "Three strokes in a row across the enemy: right to left, left to right, then straight down; three spark pops and a crack.",
      "side": "The two flat cuts are quick bright lines through the chest, then the tall falling arc of the finisher and the enemy thrown back.",
      "top": "Hero for the rhythm: two half-moons sweeping opposite ways in front of the caster, then a straight line and a crack at the enemy's feet.",
      "three_quarter": "Each arc, each hit and the final stagger read in turn."
    }
