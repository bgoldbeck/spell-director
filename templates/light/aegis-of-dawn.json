  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "From behind the caster the shield is a full disc of light with a bright rim and a turning sigil, rays fanning out around its edge.",
      "side": "The shield is a thin curved lens standing in front of the caster, its rim brightest at the edges, with rays shooting out of it and a big bloom around it.",
      "top": "A bright curved sliver in front of the caster with light pooled on the ground below it and rays spreading out.",
      "three_quarter": "Hero view. The lens shape, the sigil face, the bloom and the sunrays all read together."
    }
  },
