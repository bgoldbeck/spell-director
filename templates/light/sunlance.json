  "id": "light-sunlance",
  "name": "Sunlance",
  "description": "The caster stands still and drinks in sunlight: motes of gold and green drift in from all around and spiral into a growing sun in their hand while a glyph opens under their feet. Then a thick lance of golden-white light, wound with two spiralling threads, pours into the target and floods it with light, leaving a glowing sun-mark.",
  "element": "light",
  "archetype": "beam",
  "tags": [
    "charged",
    "solar",
    "nature",
    "beam",
    "sustained",
    "long-windup",
    "heavy"
  ],
  "source": {
    "kind": "director_text",
    "prompt": "A charged solar/nature beam: a long wind-up gathering sunlight, then a big beam of light. Original, inspired by the solar-beam archetype common in creature-battle games."
  },
  "timing": {
    "duration_ms": 2700,
    "fps_hint": 30
  },
  "space": {
    "origin": "caster_hand",
    "destination": "target",
    "travel": "beam",
    "scale": 1.0,
    "footprint": {
      "shape": "line",
      "length": 4.2,
      "distribution": "center_weighted"
    },
    "caster_gestures": [
      {
        "kind": "push",
        "at_ms": 700,
        "duration_ms": 450,
        "hold_ms": 770
      }
    ]
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "From over the caster's shoulder the sun in the hand swells as motes stream past the camera into it; on release the lance fills the centre of the frame and recedes to a bright bloom of light on the target.",
      "side": "The best read of the wind-up and the lance: motes curl in from above, below and all round, then a thick level column of light runs the full length with two threads corkscrewing along it, and a fountain of motes rises off the target.",
      "top": "The ground carries the wind-up: a sun glyph opening and turning under the caster, a contracting ring of light and motes spiralling in. Then the lance is a broad bright line with the spirals weaving across it, a ring bursting out at the target and a glowing sun-mark left behind.",
      "three_quarter": "Hero view. The glyph reads as an ellipse under the caster, the gathering spiral is clearly 3D, the lance recedes with its threads winding round it, and the light fountain and sun-mark read at the far end."
    }
  },
  "palette": {
    "core": "#FFFDEB",
    "primary": "#FFCE45",
    "secondary": "#7FD34E",
    "accent": "#FFF0A0",
    "shadow": "#3B3422"
  },
