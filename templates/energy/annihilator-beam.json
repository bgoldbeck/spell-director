    {
      "id": "explode",
      "phase": "impact",
      "start_ms": 1060,
      "end_ms": 1960,
      "intensity": {
        "shape": "flicker",
        "from": 0.7,
        "to": 1.0,
        "flicker_hz": 12
      },
      "intent": "The target disappears in a blast: a big flash, a fireball of energy billowing up, a shockwave across the ground, debris and sparks thrown out, a crater punched into the ground and a long, heavy shake."
    },
    {
      "id": "recharge",
      "phase": "dissipation",
