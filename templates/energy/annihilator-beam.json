{
  "schema": "spelldirector.template/0.1.0",
  "id": "energy-annihilator-beam",
  "name": "Annihilator Beam",
  "description": "The caster pours everything into one shot: raw energy is dragged in from the ground around them into a shuddering white-hot core, then a massive beam wound with corkscrewing energy tears across the field with a recoil that cracks the ground under their feet and shoves them back. The target vanishes in a blast. Afterwards the caster is spent, vents smoke and sputters while they recharge.",
  "element": "energy",
  "archetype": "beam",
  "tags": [
    "beam",
    "hyper",
    "massive",
    "recoil",
    "recharge",
    "explosion",
    "ultimate",
    "heavy"
  ],
  "source": {
    "kind": "director_text",
    "prompt": "A massive raw energy beam with recoil: a huge charge, a screen-filling beam, a big explosion, and the caster has to recover afterwards. Original, inspired by the all-out hyper-beam archetype common in creature-battle games."
  },
  "timing": {
    "duration_ms": 3000,
    "fps_hint": 30
  },
  "space": {
    "origin": "caster_hand",
    "destination": "target",
    "travel": "beam",
    "scale": 1.0,
    "footprint": {
      "shape": "line",
      "length": 4.4,
      "distribution": "center_weighted"
    },
    "caster_gestures": [
      {
        "kind": "push",
        "at_ms": 510,
        "duration_ms": 450,
        "hold_ms": 900
      }
    ]
  },
  "views": {
    "hero": "three_quarter",
    "reads": {
      "front": "Behind the caster: the core in the hand swells and shudders with arcs crawling round it, then the beam fills the middle of the frame, a corkscrewing tunnel of light rushing to an explosion at the far end. The recoil ring bursts past the camera.",
      "side": "The full length of a very thick beam with three energy strands corkscrewing along it, a vertical shockwave ring at the caster's hand, the explosion and smoke column at the target, and the spent caster venting smoke afterwards.",
      "top": "The ground tells the story: energy dragged in across the ground, a cracked recoil mark and a dust ring blasting out under the caster, a broad bright line to the target, a big shockwave and a crater there, and the caster sputtering at the end.",
      "three_quarter": "Hero view. The beam reads as a thick 3D column receding to the target with its strands winding round it, the recoil ring stands across the line of fire, the explosion rises tall, and both ground marks (recoil cracks, target crater) read as ellipses."
    }
  },
  "readability": {
    "reference_distance": 4.4,
    "view_distances": [
      6,
      12,
      20
    ],
    "must_read": [
      {
        "cue": "overload tell at the hand",
        "layers": [
          "core",
          "core-glow",
          "hand-arcs"
        ],
        "beat": "overload",
        "measure": "size",
        "why": "The last moment to dodge: the charging core must read from range."
      },
      {
        "cue": "white-hot core in the beam",
        "layers": [
          "beam"
        ],
        "beat": "blast",
        "measure": "core",
        "why": "The core is what makes it a beam of raw energy rather than a red fog; check it survives at distance."
      },
      {
        "cue": "beam as wide as a body",
        "layers": [
          "beam"
        ],
        "beat": "blast",
        "measure": "thickness",
        "why": "Its size is the threat: it should read as a massive column, not a laser."
      },
      {
        "cue": "the blast swallowing the target",
        "layers": [
          "explosion-flash",
          "fireball"
        ],
        "beat": "explode",
        "at_ms": 1150,
        "measure": "size",
        "why": "A clear first hit on the target."
      }
    ],
    "key_frames": [
      {
        "label": "overload",
        "t_ms": 900,
        "note": "The core at the hand shudders and flickers, arcs go wild: the tell must read even at range."
      },
      {
        "label": "ignition",
        "t_ms": 1000,
        "note": "The beam tears loose with a blinding flash and a recoil ring at the hand."
      },
      {
        "label": "first contact",
        "t_ms": 1100,
        "note": "The beam reaches the target, which vanishes in a flash and a billowing fireball."
      },
      {
        "label": "shutdown",
        "t_ms": 2000,
        "note": "The beam has collapsed; smoke columns over the crater, which stays where it landed, and vents from the caster's hand."
      }
    ]
  },
