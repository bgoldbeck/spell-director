      "end_ms": 3000,
      "intensity": {
        "shape": "ease_out",
        "from": 0.7,
        "to": 0.0
      },
      "intent": "The beam has collapsed to nothing. The caster is spent: smoke vents from the hand, a few weak sparks sputter around them while they recharge, and a smoke column rises over the crater."
    }
  ],
