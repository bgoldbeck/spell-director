{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bgoldbeck/spell-director/schemas/template-0.1.0.schema.json",
  "title": "SpellDirector effect template",
  "description": "A director-written recipe for a spell effect. A renderer turns template + seed into frames. See docs/template-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "element",
    "archetype",
    "timing",
    "space",
    "views",
    "palette",
    "beats",
    "layers"
  ],
  "properties": {
    "schema": {
      "const": "spelldirector.template/0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string"
    },
    "element": {
      "enum": [
        "lightning",
        "fire",
        "ice",
        "water",
        "earth",
        "wind",
        "light",
        "shadow",
        "arcane",
        "nature",
        "poison",
        "energy",
        "psychic",
        "blood",
        "sound",
        "spirit"
      ]
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "description": "Optional spell line (class, school or skill line) the spell belongs to, e.g. \"Bard\", \"Necromancer\". The viewer can group spells by it."
    },
    "archetype": {
      "enum": [
        "strike",
        "projectile",
        "chain",
        "beam",
        "aura",
        "nova"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "description": "Where this template came from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "handwritten",
            "director_text",
            "director_gif"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "description": "File name or URL of the reference GIF, if any."
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 20000
        },
        "fps_hint": {
          "type": "integer",
          "minimum": 6,
          "maximum": 120,
          "default": 30
        },
        "loop": {
          "type": "boolean",
          "default": false
        },
        "loop_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_ms",
            "end_ms"
          ],
          "description": "An aura's sustain section: the frames from start_ms to end_ms loop seamlessly for as long as the aura lasts (start-up before, end after).",
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0
            },
            "end_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "destination",
        "travel",
        "footprint"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/anchor"
        },
        "destination": {
          "enum": [
            "caster",
            "sky",
            "ground",
            "target",
            "point",
            "targets",
            "none"
          ]
        },
        "travel": {
          "enum": [
            "instant",
            "projectile",
            "beam",
            "chain",
            "none"
          ]
        },
        "scale": {
          "$ref": "#/$defs/number_or_range",
          "description": "World units; 1 = one character height."
        },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape"
          ],
          "properties": {
            "shape": {
              "enum": [
                "point",
                "line",
                "cone",
                "circle",
                "arc",
                "ring"
              ]
            },
            "length": {
              "$ref": "#/$defs/number_or_range"
            },
            "radius": {
              "$ref": "#/$defs/number_or_range"
            },
            "angle_deg": {
              "$ref": "#/$defs/number_or_range"
            },
            "distribution": {
              "enum": [
                "even",
                "random",
                "center_weighted",
                "edge_weighted",
                "spiral"
              ]
            }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "$ref": "#/$defs/int_or_range"
            },
            "hop_delay_ms": {
              "$ref": "#/$defs/number_or_range"
            },
            "max_hop_distance": {
              "$ref": "#/$defs/number_or_range"
            },
            "layout": {
              "enum": [
                "chain",
                "splash"
              ],
              "description": "chain (default): targets strung out in the footprint, hit in turn. splash: one primary target the caster picks, with the rest standing round it within radius; layers anchored at \"splash\" repeat on each of them."
            },
            "radius": {
              "$ref": "#/$defs/number_or_range",
              "description": "splash: how far round the primary target the other enemies stand, in world units (1 = one character height)."
            },
            "ripple_ms": {
              "$ref": "#/$defs/number_or_range",
              "description": "splash: a splash target's layers start this many ms later per world unit of distance from the primary target (default 120; 0 = all at once)."
            },
            "order": {
              "enum": [
                "ripple",
                "sequence"
              ],
              "description": "splash: ripple (default) delays each splash target by its distance from the primary; sequence hits them one after another, hop_delay_ms apart, going round the primary (a ricochet)."
            }
          }
        }
      }
    },
    "views": {
      "description": "How the effect reads from each standard camera. Every template is authored in 3D so all four views render from the same data. See docs/vocabulary.md#camera-views.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero",
        "reads"
      ],
      "properties": {
        "hero": {
          "$ref": "#/$defs/view",
          "description": "The view the effect is designed to look best from (usually the game's camera)."
        },
        "reads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "front",
            "side",
            "top",
            "three_quarter"
          ],
          "properties": {
            "front": {
              "type": "string",
              "minLength": 1,
              "description": "What the player should see in the front view."
            },
            "side": {
              "type": "string",
              "minLength": 1,
              "description": "What the player should see in the side view."
            },
            "top": {
              "type": "string",
              "minLength": 1,
              "description": "What the player should see in the top view."
            },
            "three_quarter": {
              "type": "string",
              "minLength": 1,
              "description": "What the player should see in the three_quarter view."
            }
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "primary"
      ],
      "properties": {
        "core": {
          "$ref": "#/$defs/color"
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "secondary": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "shadow": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "The art style this template is meant for (the viewer and export can switch to any other). See docs/template-format.md#style and docs/vocabulary.md section 12.",
      "properties": {
        "preset": {
          "enum": [
            "stylized",
            "realistic",
            "toon",
            "pixel"
          ],
          "description": "stylized (default): saturated, soft, strong bloom. realistic: lit, depth decals, heat haze, filmic. toon: cel bands and ink outlines. pixel: low-res pixel art."
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How deep carved decals look in the realistic style, default 0.6."
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Color saturation in the viewer for this preset (1 = as authored)."
        },
        "outline": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ink outline strength (toon)."
        },
        "bloom": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Multiplier on the preset's bloom strength."
        },
        "notes": {
          "type": "string",
          "description": "What the style should feel like for this spell, for the engine artist."
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "start_ms",
          "end_ms",
          "intensity"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "phase": {
            "enum": [
              "anticipation",
              "release",
              "travel",
              "impact",
              "dissipation"
            ]
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "intensity": {
            "$ref": "#/$defs/curve"
          },
          "intent": {
            "type": "string",
            "description": "Plain-language note on what this beat should feel like."
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "beats"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "type": {
            "enum": [
              "bolt",
              "glow",
              "flash",
              "sparks",
              "crackle",
              "orb",
              "beam",
              "eruption",
              "vortex",
              "wave",
              "ring",
              "decal",
              "smoke",
              "light",
              "camera_shake",
              "sound_cue"
            ]
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/local_id"
            },
            "description": "Beat ids this layer is active in."
          },
          "anchor": {
            "$ref": "#/$defs/anchor"
          },
          "plane": {
            "enum": [
              "billboard",
              "ground",
              "vertical",
              "volume"
            ],
            "description": "How the layer sits in 3D, which decides how it looks in each view. Defaults per layer type are in docs/template-format.md."
          },
          "attach_to": {
            "$ref": "#/$defs/local_id",
            "description": "Another layer this one follows (e.g. glow around a bolt)."
          },
          "blend": {
            "enum": [
              "add",
              "alpha",
              "screen",
              "multiply"
            ],
            "default": "add"
          },
          "color": {
            "enum": [
              "core",
              "primary",
              "secondary",
              "accent",
              "shadow",
              "gradient_core_to_primary",
              "gradient_primary_to_secondary"
            ]
          },
          "z": {
            "type": "integer",
            "description": "Draw order; higher is in front."
          },
          "params": {
            "$ref": "#/$defs/params"
          },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t_ms",
                "param",
                "value"
              ],
              "properties": {
                "t_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "param": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "ease": {
                  "enum": [
                    "linear",
                    "ease_in",
                    "ease_out",
                    "ease_in_out",
                    "step"
                  ]
                }
              }
            }
          },
          "shader": {
            "$ref": "#/$defs/shader"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "decal"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "params": {
                  "properties": {
                    "shape": {
                      "enum": [
                        "scorch",
                        "burn",
                        "cracks",
                        "crater",
                        "puddle",
                        "splash",
                        "frost",
                        "swirl",
                        "swept",
                        "slash",
                        "rune_circle",
                        "warning_ring",
                        "fissures"
                      ],
                      "description": "What the mark looks like from above. See docs/template-format.md#decals."
                    },
                    "radius_px": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 1
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Radius of the mark at full size (100 px = one character height)."
                    },
                    "opacity": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Peak opacity, default 0.85."
                    },
                    "fade_in_ms": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Fade in from the start of its first beat, default 60."
                    },
                    "lifetime_ms": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "How long it stays at full strength from its start (default: until its last beat ends). May run past the spell's end: the mark stays on the ground."
                    },
                    "fade_ms": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Fade out after the lifetime, default 400."
                    },
                    "grow_ms": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Grow from start_scale to full size over this long (0 = appear at full size)."
                    },
                    "start_scale": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Size it grows from, default 0.6."
                    },
                    "rotation_deg": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Angle on the ground, counter-clockwise from the cast direction. Omit for a random angle per cast."
                    },
                    "spin_deg_per_s": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Turning speed (rune circles), default 0."
                    },
                    "stretch": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 10
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Length along its rotation axis relative to its width, default 1."
                    },
                    "pulse_hz": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Opacity pulse rate (warning rings), default 0."
                    },
                    "detail": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "How busy the texture is (cracks, rays, glyphs), default 0.5."
                    },
                    "arc_deg": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 360
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Keep only the sector facing the cast direction, this many degrees wide (default 360: the whole mark). Without a rotation_deg, an arc mark faces the cast direction."
                    },
                    "reveal_ms": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "The mark spreads out from its centre over this long from its start, like cracks running across the ground (default 0: appears whole)."
                    },
                    "depth": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "How carved the mark looks with depth (realistic): 1 deep, 0 flat, negative raised. Default per shape."
                    },
                    "fill": {
                      "enum": [
                        "none",
                        "lava",
                        "glow",
                        "liquid",
                        "void"
                      ],
                      "description": "What sits in the bottom of the mark: lava, glow (energy light), liquid (water, blood), void (darkness). Default none."
                    },
                    "fill_color": {
                      "enum": [
                        "core",
                        "primary",
                        "secondary",
                        "accent",
                        "shadow",
                        "gradient_core_to_primary",
                        "gradient_primary_to_secondary"
                      ],
                      "description": "Palette slot of the fill. Default: lava gradient_core_to_primary, glow the layer's color, liquid primary, void shadow."
                    },
                    "fill_flow": {
                      "type": "number",
                      "minimum": 0,
                      "description": "How fast the fill flows (1 = default)."
                    },
                    "fill_in_ms": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Time for the fill to rise into the mark from its start, default 200."
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "light"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "params": {
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "How far it reaches, in world units (1 = one character height), default 6."
                    },
                    "energy": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Brightness at full intensity, default 2."
                    },
                    "height_px": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Height above the ground, default 80; negative = under the ground (an under light)."
                    },
                    "forward_px": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Offset from the anchor along the cast direction (negative = behind it), default 0."
                    },
                    "side_px": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Offset from the anchor to the side, positive = left of the cast direction, default 0."
                    },
                    "orbit_hz": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/range"
                        }
                      ],
                      "description": "Turns per second it circles the anchor at its forward/side distance (counter-clockwise seen from above; negative = clockwise), default 0."
                    },
                    "tint": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "description": "A light color outside the palette (#RRGGBB), e.g. neon stage or rim lights. Overrides the layer's color slot."
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seeded": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "director_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "local_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "anchor": {
      "enum": [
        "caster",
        "caster_hand",
        "sky",
        "ground",
        "target",
        "point",
        "splash",
        "screen"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "number_or_range": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/range"
        }
      ]
    },
    "int_or_range": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/range"
        }
      ]
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "enum": [
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "spike",
            "flicker",
            "hold"
          ]
        },
        "from": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "to": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flicker_hz": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "params": {
      "description": "Layer parameters. Any value may be a number, a {min,max} range (picked per cast from the seed), a boolean or a short enum string. Known keys per layer type are listed in docs/template-format.md.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "$ref": "#/$defs/range"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "view": {
      "enum": [
        "front",
        "side",
        "top",
        "three_quarter"
      ]
    },
    "shader": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shader intent: how an engine should build this layer's look with shaders and particles. A description, not pixels. See docs/vocabulary.md section 11.",
      "properties": {
        "material": {
          "enum": [
            "ionized",
            "plasma",
            "wet",
            "liquid",
            "foamy",
            "glassy",
            "crystalline",
            "icy",
            "molten",
            "fiery",
            "smoky",
            "ashen",
            "dusty",
            "airy",
            "ethereal",
            "arcane",
            "shadowy",
            "organic",
            "stone",
            "metallic"
          ],
          "description": "What the layer is made of; sets the overall feel."
        },
        "look": {
          "type": "string",
          "description": "One sentence on what the shader should feel like."
        },
        "technique": {
          "enum": [
            "procedural",
            "flipbook",
            "particles",
            "ribbon",
            "mesh",
            "decal",
            "light",
            "post_process"
          ],
          "description": "How to build it in an engine."
        },
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "perlin",
                "simplex",
                "fbm",
                "ridged",
                "voronoi",
                "curl",
                "streaks"
              ]
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Noise cells per character height (1 world unit). Small = broad blobs, large = fine grain."
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "description": "How fast the noise moves or evolves, in world units per second."
            },
            "contrast": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": [
                "none",
                "along_path",
                "outward",
                "inward",
                "upward",
                "downward",
                "swirl",
                "toward_target"
              ]
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "description": "UV scroll / flow speed in world units per second."
            }
          }
        },
        "distortion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Refraction or heat-haze strength behind the layer (0 none, 1 strong)."
        },
        "fresnel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rim brightness at grazing angles (0 none, 1 strong edge glow)."
        },
        "dissolve": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "enum": [
                "perlin",
                "simplex",
                "fbm",
                "ridged",
                "voronoi",
                "streaks"
              ]
            },
            "edge_width": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "edge_color": {
              "enum": [
                "core",
                "primary",
                "secondary",
                "accent",
                "shadow"
              ],
              "description": "Palette slot for the burning edge."
            }
          },
          "description": "How the layer erodes away as it fades, instead of a plain fade."
        },
        "emissive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hdr": {
              "type": "number",
              "minimum": 0,
              "description": "Brightness multiplier into bloom: 1 = no bloom, 2-4 glowing, 5-10 blinding."
            },
            "falloff": {
              "enum": [
                "hard",
                "soft",
                "exponential",
                "gaussian"
              ]
            },
            "core_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How much of the width is the white-hot core."
            }
          }
        },
        "lighting": {
          "enum": [
            "unlit",
            "lit",
            "emits_light",
            "six_way"
          ],
          "description": "unlit: draws its own light; lit: shaded by the scene's lights; emits_light: also lights the scene; six_way: smoke relit from six baked directions (six-way lightmaps), see docs/vocabulary.md#six-way-lit-smoke."
        },
        "notes": {
          "type": "string"
        },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-style refinements of this shader intent (merged over it when the spell is built in that style), e.g. a realistic look sentence or material.",
          "properties": {
            "stylized": {
              "$ref": "#/$defs/shader"
            },
            "realistic": {
              "$ref": "#/$defs/shader"
            },
            "toon": {
              "$ref": "#/$defs/shader"
            },
            "pixel": {
              "$ref": "#/$defs/shader"
            }
          }
        }
      }
    }
  }
}
